{
  "name": "@asterism/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "pregenerate:api": "cargo run --manifest-path ../Cargo.toml -q -p asterism-api --example export_openapi -- .openapi/asterism.json",
    "generate:api": "openapi-ts -i .openapi/asterism.json -o src/api/generated",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc -b",
    "prebuild": "npm run generate:api",
    "build": "vite build"
  },
  "dependencies": {
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
